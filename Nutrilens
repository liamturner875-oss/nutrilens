  const carbs = n["carbohydrates_100g"] || 0;
  const fats = n["fat_100g"] || 0;
  let calories =
    n["energy-kcal_100g"] != null ? n["energy-kcal_100g"] : n["energy_100g"] != null ? n["energy_100g"] / 4.184 : null;
